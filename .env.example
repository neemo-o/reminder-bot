NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=mistralai/mistral-7b-instruct-v0.3
TEST_PHONE_NUMBER=
DATABASE_PATH=reminder_bot.db
LOG_LEVEL=info

# --- Áudio / transcrição local (NOVO) ---
# Caminho do binário ffmpeg (obrigatório para conversão de áudio).
# No Hermes/Windows costuma estar em:
#   C:\Users\NEEMIAS\AppData\Local\hermes\tools\ffmpeg-9.0.1-win32-x64\bin\ffmpeg
FFMPEG_PATH=ffmpeg

# Habilita/desabilita transcrição local de áudio (padrão: true)
AUDIO_TRANSCRIPTION_ENABLED=true

# Modelo Whisper para transcrição local (padrão: Xenova/whisper-small)
# Alternativas leves: Xenova/whisper-base, Xenova/whisper-tiny
WHISPER_MODEL=Xenova/whisper-small

# Idioma forçado na transcrição (opcional; ex: 'portuguese', 'english')
# Deixe vazio para detecção automática.
WHISPER_LANGUAGE=portuguese
