{
  "name": "whatsapp-reminder-bot",
  "version": "1.0.0",
  "description": "WhatsApp Reminder Bot MVP using Baileys, SQLite, and NVIDIA NIM API",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.18",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^16.4.7",
    "node-cron": "^3.0.3",
    "openai": "^4.85.4",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
